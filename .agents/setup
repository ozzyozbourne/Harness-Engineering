#!/usr/bin/env bash
# Orb setup for harness-engineering.
#
# Installs the toolchains this repo uses: Rust (rustup, latest stable),
# Common Lisp (SBCL, latest release), Python (latest CPython via uv),
# and TypeScript (latest tsc via npm). Node.js ships with the orb base
# template and is kept up to date opportunistically.
#
# Idempotent: each step checks before installing. Fast on a warm filesystem.
set -euo pipefail

step() { echo "[setup] $1"; }

# --- Rust (latest stable via rustup) -----------------------------------------
export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null 2>&1; then
  step "Installing rustup + latest stable Rust"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
else
  source "$HOME/.cargo/env" 2>/dev/null || true
  step "rustup present; updating stable toolchain"
  rustup update stable >/dev/null
fi

# --- SBCL (latest release runnable on Debian 12) -------------------------------
# apt's sbcl is far behind; install the official Linux x86-64 binary release.
sbcl_target="/usr/local/bin/sbcl"
sbcl_core="/usr/local/lib/sbcl"
sbcl_version="2.4.11"
if [[ "$(sbcl --version 2>/dev/null)" != "SBCL $sbcl_version" ]]; then
  step "Installing SBCL $sbcl_version"
  # Newest official binary that runs on Debian 12: releases from 2.5.x on
  # require GLIBC 2.38, the orb ships 2.36.
  tmp="$(mktemp -d)"
  curl -sSL "https://downloads.sourceforge.net/project/sbcl/sbcl/$sbcl_version/sbcl-$sbcl_version-x86-64-linux-binary.tar.bz2" -o "$tmp/sbcl.tar.bz2"
  tar -xjf "$tmp/sbcl.tar.bz2" -C "$tmp"
  ( cd "$tmp/sbcl-$sbcl_version-x86-64-linux" && sh install.sh --prefix=/usr/local >/dev/null )
  rm -rf "$tmp"
fi

# --- Clojure (latest CLI tools) -------------------------------------------------
clojure_version="1.12.6.1673"
if ! command -v clj >/dev/null 2>&1 || ! grep -q "$clojure_version" <(clojure --version 2>/dev/null); then
  step "Installing Clojure $clojure_version"
  curl -sSL "https://download.clojure.org/install/linux-install-$clojure_version.sh" -o /tmp/clojure-install.sh
  bash /tmp/clojure-install.sh --prefix /usr/local >/dev/null
  rm -f /tmp/clojure-install.sh
fi

# --- Elixir + Erlang/OTP (latest releases) --------------------------------------
# Debian 12's apt Erlang is OTP 25, too old for current Elixir. hex.pm publishes
# precompiled OTP builds for Ubuntu 22.04 (GLIBC 2.35, runs on Debian 12), and
# Elixir ships precompiled zips per OTP major.
otp_version="29.1.1"
elixir_version="1.20.4"
# Erlang reports the major ("29") at runtime; check the full version file instead.
erlang_version_file="/usr/local/lib/erlang/releases/${otp_version%%.*}/OTP_VERSION"
if ! grep -qx "$otp_version" "$erlang_version_file" 2>/dev/null; then
  step "Installing Erlang/OTP $otp_version"
  tmp="$(mktemp -d)"
  curl -sSL "https://builds.hex.pm/builds/otp/ubuntu-22.04/OTP-$otp_version.tar.gz" -o "$tmp/otp.tar.gz"
  tar -xzf "$tmp/otp.tar.gz" -C "$tmp"
  mkdir -p /usr/local/lib/erlang
  rm -rf /usr/local/lib/erlang/*
  cp -r "$tmp/OTP-$otp_version"/* /usr/local/lib/erlang/
  rm -rf "$tmp"
  ( cd /usr/local/lib/erlang && ./Install -minimal /usr/local/lib/erlang >/dev/null )
  ln -sf /usr/local/lib/erlang/bin/erl /usr/local/bin/erl
  ln -sf /usr/local/lib/erlang/bin/erlc /usr/local/bin/erlc
fi
if ! command -v elixir >/dev/null 2>&1 || ! grep -q "$elixir_version" <(elixir --version 2>/dev/null); then
  step "Installing Elixir $elixir_version"
  tmp="$(mktemp -d)"
  curl -sSL "https://github.com/elixir-lang/elixir/releases/download/v$elixir_version/elixir-otp-29.zip" -o "$tmp/elixir.zip"
  mkdir -p /usr/local/lib/elixir
  rm -rf /usr/local/lib/elixir/*
  unzip -q "$tmp/elixir.zip" -d /usr/local/lib/elixir
  rm -rf "$tmp"
  for b in elixir elixirc mix iex; do ln -sf /usr/local/lib/elixir/bin/$b /usr/local/bin/$b; done
fi

# --- Python (latest CPython via uv) -------------------------------------------
if ! command -v uv >/dev/null 2>&1; then
  step "Installing uv"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
fi
python_version="3.14"
step "Installing Python $python_version via uv"
uv python install "$python_version" --default >/dev/null 2>&1 || uv python install "$python_version" >/dev/null
# Make `python3`/`python` on PATH resolve to the uv-managed latest Python.
uv_python_bin="$(uv python find "$python_version" 2>/dev/null || true)"
if [[ -n "$uv_python_bin" ]]; then
  uv_python_dir="$(dirname "$uv_python_bin")"
  for name in python3 python; do
    ln -sfn "$uv_python_bin" "/usr/local/bin/$name"
  done
fi

# --- TypeScript (latest via npm) ----------------------------------------------
step "Installing latest TypeScript globally"
npm install -g typescript tsx >/dev/null 2>&1 || npm install -g typescript tsx

echo "[setup] Done:"
echo "  $(rustc --version 2>/dev/null || echo rustc MISSING)"
echo "  $(sbcl --version 2>/dev/null || echo sbcl MISSING)"
echo "  $(clojure --version 2>/dev/null || echo clojure MISSING)"
echo "  $(elixir --version 2>/dev/null | tail -1 || echo elixir MISSING)"
echo "  $(python3 --version 2>/dev/null || echo python3 MISSING)"
echo "  $(tsc --version 2>/dev/null || echo tsc MISSING)"
echo "  $(node --version 2>/dev/null || echo node MISSING)"
